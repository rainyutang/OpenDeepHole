{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delta.schema.json",
  "title": "Coverage-guided threat analysis supplement",
  "type": "object",
  "required": [
    "path_results",
    "module_updates",
    "new_modules",
    "new_value_assets"
  ],
  "properties": {
    "path_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "input_path",
          "path",
          "status",
          "reason",
          "evidence"
        ],
        "properties": {
          "input_path": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "incomplete"
            ]
          },
          "classification": {
            "type": "string",
            "enum": [
              "existing_module",
              "non_high_risk",
              "new_module"
            ]
          },
          "module_name": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "file",
                "line_start",
                "line_end"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "module_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "module_name",
          "add_code_paths",
          "set_fields"
        ],
        "properties": {
          "module_name": {
            "type": "string",
            "minLength": 1
          },
          "add_code_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "set_fields": {
            "type": "object",
            "properties": {
              "面临威胁": {
                "type": "string",
                "minLength": 1
              },
              "是否涉及设备或系统对外提供管理和控制接口相关的代码": {
                "type": "string",
                "enum": [
                  "是",
                  "否"
                ]
              },
              "是否涉及对不可信来源数据进行解析或处理的代码": {
                "type": "string",
                "enum": [
                  "是",
                  "否"
                ]
              },
              "是否涉及安全相关类代码(如，认证、授权、接入控制、加解密、密钥管理、日志审计、软件完整性保护等模块)": {
                "type": "string",
                "enum": [
                  "是",
                  "否"
                ]
              },
              "是否涉及个人数据或者敏感数据的代码": {
                "type": "string",
                "enum": [
                  "是",
                  "否"
                ]
              },
              "是否涉及web相关处理": {
                "type": "string",
                "enum": [
                  "是",
                  "否"
                ]
              },
              "是否外部暴露面": {
                "type": "string",
                "enum": [
                  "是",
                  "否"
                ]
              },
              "判断为高风险模块的原因": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "new_modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "模块名称",
          "代码目录",
          "面临威胁",
          "是否涉及设备或系统对外提供管理和控制接口相关的代码",
          "是否涉及对不可信来源数据进行解析或处理的代码",
          "是否涉及安全相关类代码(如，认证、授权、接入控制、加解密、密钥管理、日志审计、软件完整性保护等模块)",
          "是否涉及个人数据或者敏感数据的代码",
          "是否涉及web相关处理",
          "是否外部暴露面",
          "判断为高风险模块的原因"
        ],
        "properties": {
          "模块名称": {
            "type": "string",
            "minLength": 1
          },
          "代码目录": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "面临威胁": {
            "type": "string",
            "minLength": 1
          },
          "是否涉及设备或系统对外提供管理和控制接口相关的代码": {
            "type": "string",
            "enum": [
              "是",
              "否"
            ]
          },
          "是否涉及对不可信来源数据进行解析或处理的代码": {
            "type": "string",
            "enum": [
              "是",
              "否"
            ]
          },
          "是否涉及安全相关类代码(如，认证、授权、接入控制、加解密、密钥管理、日志审计、软件完整性保护等模块)": {
            "type": "string",
            "enum": [
              "是",
              "否"
            ]
          },
          "是否涉及个人数据或者敏感数据的代码": {
            "type": "string",
            "enum": [
              "是",
              "否"
            ]
          },
          "是否涉及web相关处理": {
            "type": "string",
            "enum": [
              "是",
              "否"
            ]
          },
          "是否外部暴露面": {
            "type": "string",
            "enum": [
              "是",
              "否"
            ]
          },
          "判断为高风险模块的原因": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "new_value_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "资产名",
          "资产类别",
          "资产描述",
          "攻击损失",
          "判断为价值资产的原因"
        ],
        "properties": {
          "资产名": {
            "type": "string",
            "minLength": 1
          },
          "资产类别": {
            "type": "string",
            "enum": [
              "数据资产",
              "软件资产",
              "硬件资产",
              "服务资产"
            ]
          },
          "资产描述": {
            "type": "string",
            "minLength": 1
          },
          "攻击损失": {
            "type": "string",
            "minLength": 1
          },
          "判断为价值资产的原因": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
