{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "security-audit-orchestrator",
  "subagent_depth": 2,
  "mcp": {},
  "plugin": [
    "./lib/audit-runtime/opencode-session-plugin.mjs"
  ],
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow"
    },
    "list": {
      "*": "allow"
    },
    "glob": {
      "*": "allow"
    },
    "grep": {
      "*": "allow"
    },
    "external_directory": {
      "*": "allow"
    },
    "edit": {
      "*": "deny"
    },
    "bash": {
      "*": "allow"
    },
    "task": "allow",
    "doom_loop": "allow",
    "todowrite": "deny",
    "skill": {
      "*": "allow"
    },
    "question": "deny"
  }
}
